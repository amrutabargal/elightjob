# Server
PORT=5000
NODE_ENV=development

# MongoDB - use local or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/elite_placement_hub

# JWT Secret - change to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for email verification links & CORS)
CLIENT_URL=http://localhost:5173

# Email: welcome mail on register (no OTP)
# USE_TEMP_MAIL=false + Gmail App Password (16 chars) in SMTP_PASS — NOT your login password
# https://myaccount.google.com/apppasswords
USE_TEMP_MAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
# Use 16-char App Password without spaces (or GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx)
GMAIL_APP_PASSWORD=your_gmail_app_password_16_chars
SMTP_PASS=your_gmail_app_password_16_chars
EMAIL_FROM=Elite Placement Hub <your.email@gmail.com>

# Help contact (footer, emails, auth modal)
SUPPORT_NAME=Ashok Kumar
SUPPORT_PHONE=7498115939
SUPPORT_EMAIL=your.email@gmail.com

# FREE (no key): Remotive, RemoteOK, Jobicy, Arbeitnow — remote/global jobs
# For CITY-WISE India jobs (like Naukri/Google), add ANY key below:

# Google Jobs + Indeed + LinkedIn (BEST for city search) — free tier on RapidAPI
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key

# Jooble India — free key, searches every city
# https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key

# Careerjet India — free partner id
# https://www.careerjet.com/partners/
CAREERJET_AFFID=your_careerjet_affid
CAREERJET_USER_IP=8.8.8.8

# Adzuna India — free tier, all 36 cities
# https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# Job auto-refresh interval in hours (default 24 = daily update)
JOB_REFRESH_HOURS=24

# Optional: OpenAI for enhanced AI features (leave empty to use built-in heuristics)
OPENAI_API_KEY=
